<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base configuration: disallow cleartext traffic -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Domain-specific configuration for map tiles -->
    <domain-config cleartextTrafficPermitted="false">
        <!-- MapLibre demo tiles (uses HTTPS) -->
        <domain includeSubdomains="true">demotiles.maplibre.org</domain>
        <!-- OpenStreetMap tiles (uses HTTPS) -->
        <domain includeSubdomains="true">tile.openstreetmap.org</domain>
    </domain-config>
</network-security-config>
